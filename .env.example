# Stirling PDF backend
# Copy to .env.local and fill in your API key.
VITE_PDFBRAINS_API_URL=https://pdfbrains.codewithdishu.com
VITE_PDFBRAINS_API_KEY=
# CORS relay used to fetch web pages for HTML to PDF URL mode.
# Set to your own relay if you do not want to use the public one.
VITE_HTML_FETCH_PROXY=https://api.allorigins.win/raw?url=

# LLM provider for AI Assist (DeepSeek by default).
# Swap models by changing VITE_LLM_PROVIDER and adding the provider's key
# (see src/lib/llm/index.ts for the registry).
VITE_LLM_PROVIDER=deepseek
# Get a key at https://platform.deepseek.com (API keys section).
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-chat

# Google Analytics 4 (optional).
# Paste your Measurement ID (G-XXXXXXXXXX) to enable pageview tracking.
# Leave empty to disable analytics (e.g. local dev).
VITE_GA_MEASUREMENT_ID=

# Web3Forms access key powering the in-app feedback form.
# Leave empty to hide the feedback entry points.
VITE_WEB3FORMS_KEY=
